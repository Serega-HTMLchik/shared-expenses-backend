                                            "equal",
                                            "shares",
                                            "exact"
                                        ]
                                    },
                                    "shares": {
                                        "type": "array",
                                        "items": {
                                            "type": "object"
                                        }
                                    },
                                    "spent_on": {
                                        "type": "string",
                                        "format": "date"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Расход создан"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
