                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "payer_id",
                                    "amount_cents",
                                    "split_type",
                                    "shares",
                                    "spent_on"
