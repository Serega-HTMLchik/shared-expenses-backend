{
    "openapi": "3.0.0",
    "info": {
        "title": "Shared Expenses API",
        "description": "API для совместных расходов. Защищённые методы используют Sanctum Bearer token.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "API v1"
        }
    ],
    "paths": {
        "/register": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Регистрация пользователя",
                "operationId": "f3738ecb8fdfc93a1b633f0bedbcb20f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation",
                                    "device_name"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password"
                                    },
                                    "device_name": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Пользователь и токен созданы"
                    }
                }
            }
        },
        "/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Вход и выдача токена",
                "operationId": "a984e5af129820cf564e5cf7f5094b93",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password",
                                    "device_name"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    },
                                    "device_name": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Токен выдан"
                    },
                    "422": {
                        "description": "Неверные данные"
                    }
                }
            }
        },
        "/groups": {
            "get": {
                "tags": [
                    "Groups"
                ],
                "summary": "Список групп текущего пользователя",
                "operationId": "45f26bdd1794a6df951fa6dcf1cff31e",
                "responses": {
                    "200": {
                        "description": "Список групп"
                    },
                    "401": {
                        "description": "Не авторизован"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/groups/{group}/expenses": {
            "post": {
                "tags": [
                    "Expenses"
                ],
                "summary": "Добавить расход",
                "operationId": "6ca60efc19023819ae2f9fd50460a584",
                "parameters": [
                    {
                        "name": "group",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "payer_id",
                                    "amount_cents",
                                    "split_type",
                                    "shares",
                                    "spent_on"
                                ],
                                "properties": {
                                    "payer_id": {
                                        "type": "integer"
                                    },
                                    "amount_cents": {
                                        "type": "integer",
                                        "example": 10001
                                    },
                                    "split_type": {
                                        "type": "string",
                                        "enum": [
                                            "equal",
                                            "shares",
                                            "exact"
                                        ]
                                    },
                                    "shares": {
                                        "type": "array",
                                        "items": {
                                            "type": "object"
                                        }
                                    },
                                    "spent_on": {
                                        "type": "string",
                                        "format": "date"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Расход создан"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "bearerFormat": "API token",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Authentication"
        },
        {
            "name": "Groups"
        },
        {
            "name": "Expenses"
        }
    ]
}