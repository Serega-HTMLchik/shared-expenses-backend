# Docker Compose configuration. Copy this file to .env at the repository root.
# Generate a unique BACKEND_APP_KEY for every server, for example:
# docker compose run --rm api php artisan key:generate --show
BACKEND_APP_KEY=base64:4qrpLTzwU5N2Uwk0qYQvJ7T2yUOZBH2vwrONoZCTkfk=

POSTGRES_DB=shared_expenses
POSTGRES_USER=shared_expenses
POSTGRES_PASSWORD=change-this-database-password

# Local ports. Set FRONTEND_PUBLIC_URL, APP_URL and FRONTEND_URL to HTTPS URLs on a server.
FRONTEND_PORT=5173
API_PORT=8000
REVERB_PORT=8080
FRONTEND_PUBLIC_URL=http://localhost:5173
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_ENV=production
APP_DEBUG=false

# Browser WebSocket settings. With the built-in frontend proxy use its public host and port.
VITE_REVERB_HOST=
VITE_REVERB_PORT=5173
VITE_REVERB_SCHEME=http

# Use strong, distinct values on a server.
REVERB_APP_ID=shared-expenses
REVERB_APP_KEY=shared-expenses-key
REVERB_APP_SECRET=change-this-reverb-secret

# Configure an SMTP provider to send application emails. The default `log` writes emails to logs.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Совместные расходы
